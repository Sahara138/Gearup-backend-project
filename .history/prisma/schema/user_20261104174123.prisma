model User { 
  id    Int     @id @default(autoincrement()) 
  name  String @db.VarChar(255)
  email String  @unique
  password     String
  activeStatus ActiveStatus @default(ACTIVE)
  role         Role         @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
 
} 